# Copy this file to .env and fill in YOUR values:   cp .env.example .env
# Never commit .env and never post your token anywhere.

# Required. The token @BotFather gave you when you created the bot.
BOT_TOKEN=put-your-token-from-botfather-here

# Optional. Who may use the bot: Telegram user ids separated by commas.
# Empty = anyone who finds the bot can use it. Ask @userinfobot for your id.
ALLOWED_USER_IDS=

# Optional.
LOG_LEVEL=INFO

# Optional. Local runs keep the database here. (In Docker it always lives in the bot-data volume.)
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
